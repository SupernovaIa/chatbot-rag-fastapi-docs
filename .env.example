# Copia este fichero a .env y rellena los valores. .env nunca se commitea.

# Google AI Studio — única API key del stack (embeddings, generación, juez, guardrail).
GOOGLE_API_KEY=

# Secreto para firmar los JWT de auth. Genera uno aleatorio largo.
JWT_SECRET=change-me-with-a-long-random-secret

# Contraseña del usuario postgres. El backend la usa vía DATABASE_URL.
POSTGRES_PASSWORD=postgres

# Endpoint del colector de Phoenix (OTLP). En Docker apunta al servicio phoenix.
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006

# Azure Blob Storage (Azurite en local). Mismo SDK, distinto endpoint en prod.
# En Docker el BlobEndpoint apunta al servicio azurite.
# La AccountKey de desarrollo de Azurite es pública y fija; ver scripts/upload_corpus.py
# o la documentación oficial: https://learn.microsoft.com/azure/storage/common/storage-use-azurite
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<azurite-dev-key>;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Tamaño de batch para embeddings (default 50, ajusta si hay rate limiting).
BATCH_SIZE=50
