# Production frontend image — multi-stage build.
#
# Stage 1 (build): installs deps, runs `npm run build` with VITE_API_URL=/api
#   so all fetch calls resolve via the nginx proxy (/api/*  →  backend:8000/*).
# Stage 2 (serve): copies dist/ into nginx:alpine and adds our nginx.conf.

# ── Stage 1: build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first (layer cache).
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL is a build-time variable: /api (same-origin, proxied by nginx).
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Stage 2: serve ──────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Replace the default nginx site config with ours.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the Vite production bundle.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
